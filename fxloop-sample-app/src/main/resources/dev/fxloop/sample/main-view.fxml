<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="dev.fxloop.sample.MainController">
  <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
  <HBox spacing="8">
    <TextField fx:id="nameField" promptText="Name" HBox.hgrow="ALWAYS"/>
    <ComboBox fx:id="categoryBox" promptText="Category"/>
    <Button fx:id="addBtn" text="Add" onAction="#addContact"/>
  </HBox>
  <TableView fx:id="contactTable" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="nameCol" text="Name" prefWidth="300"/>
      <TableColumn fx:id="categoryCol" text="Category" prefWidth="200"/>
    </columns>
  </TableView>
  <HBox spacing="8" alignment="CENTER_LEFT">
    <Button fx:id="deleteBtn" text="Delete" onAction="#deleteContact"/>
    <Button fx:id="boomBtn" text="Boom" onAction="#boom"/>
    <Button fx:id="helpBtn" text="Help"/>
    <Label fx:id="hintLabel" text="Tip: names must not be empty"/>
  </HBox>
  <Label fx:id="statusLabel"/>
</VBox>
