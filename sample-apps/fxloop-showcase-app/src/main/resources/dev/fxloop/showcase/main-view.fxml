<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.fxloop.showcase.MainController">

    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>

    <top>
        <HBox fx:id="header" styleClass="header" spacing="6">
            <Label fx:id="appTitle" text="%app.title" style="-fx-font-size: 20px; -fx-text-fill: #1e5bd8; -fx-font-weight: bold;"/>
            <TextField fx:id="searchField" promptText="%search.prompt" prefWidth="120" focusTraversable="false"/>
            <Button fx:id="refreshBtn" text="⟳" styleClass="icon-button" onAction="#onRefresh"/>
            <Button fx:id="settingsBtn" text="⚙" styleClass="icon-button" onAction="#onOpenSettings"/>
            <Label fx:id="notificationBadge" text="3" styleClass="badge" translateX="-14" translateY="-4"/>
            <Button fx:id="newTicketBtn" text="%action.newTicket" styleClass="primary-button" onAction="#onNewTicket"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="2">
            <ToggleButton fx:id="navTickets" text="%nav.tickets" toggleGroup="$navGroup" selected="true" userData="tickets"
                          styleClass="nav-button" prefWidth="90" focusTraversable="false" onAction="#onNav"/>
            <ToggleButton fx:id="navCustomers" text="%nav.customers" toggleGroup="$navGroup" userData="customers"
                          styleClass="nav-button" prefWidth="90" focusTraversable="false" onAction="#onNav"/>
            <ToggleButton fx:id="navReports" text="%nav.reports" toggleGroup="$navGroup" userData="reports"
                          styleClass="nav-button" prefWidth="90" focusTraversable="false" onAction="#onNav"/>
            <ToggleButton fx:id="navKnowledge" text="%nav.knowledge" toggleGroup="$navGroup" userData="knowledge"
                          styleClass="nav-button" prefWidth="90" focusTraversable="false" onAction="#onNav"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentHost">
            <AnchorPane fx:id="ticketsView">
                <TableView fx:id="ticketTable" layoutX="12" layoutY="12" prefWidth="520" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="idCol" text="#" prefWidth="44"/>
                        <TableColumn fx:id="subjectCol" text="%col.subject" prefWidth="130"/>
                        <TableColumn fx:id="customerCol" text="%col.customer" prefWidth="120"/>
                        <TableColumn fx:id="priorityCol" text="%col.priority" prefWidth="56"/>
                        <TableColumn fx:id="statusCol" text="%col.status" prefWidth="80"/>
                        <TableColumn fx:id="updatedCol" text="%col.updated" prefWidth="70"/>
                    </columns>
                </TableView>

                <VBox fx:id="detailPane" styleClass="card" layoutX="548" layoutY="12" prefWidth="300" spacing="4">
                    <Label fx:id="detailTitle" text="%detail.title" styleClass="section-title"/>
                    <HBox spacing="4">
                        <Label text="%field.subject" prefWidth="60"/>
                        <TextField fx:id="subjectField"/>
                    </HBox>
                    <HBox spacing="4">
                        <Label text="%field.customer" prefWidth="80"/>
                        <TextField fx:id="customerField" editable="false"/>
                    </HBox>
                    <HBox spacing="4">
                        <Label text="%field.status" prefWidth="50"/>
                        <ComboBox fx:id="statusCombo"/>
                    </HBox>
                    <HBox spacing="4">
                        <Label text="%field.priority" prefWidth="70"/>
                        <ComboBox fx:id="priorityCombo"/>
                    </HBox>
                    <HBox>
                        <Label text="%field.assignee" prefWidth="64"/>
                        <TextField fx:id="assigneeField"/>
                    </HBox>
                    <Label text="%field.description"/>
                    <TextArea fx:id="descriptionArea" prefHeight="60" wrapText="true"/>
                    <HBox fx:id="detailActions">
                        <Button fx:id="saveBtn" text="%action.save" styleClass="primary-button" onAction="#onSave"/>
                        <Button fx:id="deleteBtn" text="%action.delete" styleClass="danger-button" onAction="#onDelete"/>
                        <Button fx:id="assignBtn" text="%action.assignToMe" onAction="#onAssignToMe"/>
                        <Button fx:id="clearBtn" text="%action.clear" onAction="#onClearForm"/>
                        <Button fx:id="attachBtn" text="%action.attach" onAction="#onAttach"/>
                    </HBox>
                </VBox>

                <Button fx:id="exportBtn" text="%action.export" AnchorPane.leftAnchor="1180" AnchorPane.topAnchor="12" onAction="#onExport"/>
            </AnchorPane>
        </StackPane>
    </center>

    <bottom>
        <HBox fx:id="footer" styleClass="footer" spacing="8">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <Label fx:id="statusLabel"/>
            <Region fx:id="syncIndicator" styleClass="sync-indicator"/>
            <Label fx:id="versionLabel" text="%footer.version"/>
        </HBox>
    </bottom>
</BorderPane>
