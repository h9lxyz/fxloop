<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.lab59.fxloop</groupId>
    <artifactId>fxloop-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>fxloop-dev</artifactId>
  <name>FXLoop :: Dev (embedded mode)</name>
  <description>Compile-time helper for IDE-launched apps: FxLoopDev.install() starts the agent in-process;
    FxLoopDev.load()/track() register FXML documents for live swaps. Use only in a dev profile / provided scope.</description>

  <dependencies>
    <dependency>
      <groupId>org.lab59.fxloop</groupId>
      <artifactId>fxloop-agent</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <!-- Relocate the few stdlib references this module emits, matching the shaded agent's relocation. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>org.lab59.fxloop:fxloop-dev</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>kotlin</pattern>
                  <shadedPattern>fxloop.internal.kotlin</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
