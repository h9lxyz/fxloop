<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.fxloop</groupId>
    <artifactId>fxloop-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>fxloop-acceptance</artifactId>
  <name>FXLoop :: Acceptance</name>
  <description>End-to-end acceptance suite (PRD 01 §10, PRD 02 §12, PRD 04 §5) driving the sample app through the tool surface.
    Run after install: ./mvnw -Pacceptance verify -pl fxloop-acceptance (needs xvfb-run on Linux).</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.fxloop</groupId>
      <artifactId>fxloop-server</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <fxloop.repo>${maven.multiModuleProjectDirectory}</fxloop.repo>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
          <!-- a hung suite must not hold app/Xvfb trees forever: surefire kills the fork, hooks/watchdogs reap the rest -->
          <forkedProcessTimeoutInSeconds>2400</forkedProcessTimeoutInSeconds>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
